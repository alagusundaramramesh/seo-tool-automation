# Where reports are saved: "local" (a folder on this computer) or "s3" (AWS S3 bucket)
STORAGE_DRIVER=local

# Used when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Used when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
# AWS keys are read automatically by the AWS SDK. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Maximum pages to audit per site in one run
MAX_PAGES=10

# Optional: full path to Chrome/Chromium. Leave empty to find Chrome automatically.
CHROME_PATH=

# Web dashboard port (npm start)
PORT=3000

# Set to false on a public server so nobody can audit localhost or private network addresses
ALLOW_PRIVATE_URLS=true

# true: the dashboard can fix and audit project folders on this computer by path.
# Set to false on a public server (users then upload a .zip instead).
ALLOW_LOCAL_FOLDERS=true

# Biggest project .zip users can upload
MAX_UPLOAD_MB=50

# Secret for signing login cookies. Leave empty to create one automatically (saved in storage).
SESSION_SECRET=

# Set to true when the site runs on https (online)
COOKIE_SECURE=false
